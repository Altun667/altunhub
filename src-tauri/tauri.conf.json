{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltunHub",
  "version": "1.0.0",
  "identifier": "com.altun.hub",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "AltunHub", "width": 1100, "height": 700, "minWidth": 720, "minHeight": 480 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["Turkish", "English"] } }
  }
}
